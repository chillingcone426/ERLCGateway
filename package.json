{
  "name": "@libertytools/gateway",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "dev": "tsx watch src/index.ts",
    "migrate:mongodb": "npm run build && node dist/src/migrate-mongodb.js",
    "start": "node dist/src/index.js",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "mongodb": "^6.21.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
