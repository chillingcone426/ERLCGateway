HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://libertytools:libertytools@localhost:5432/libertytools
MANAGEMENT_API_TOKEN=replace-with-a-long-random-value

# ER:LC Ed25519 public key in DER/SPKI base64. The official key is the default.
ERLC_PUBLIC_KEY_SPKI_BASE64=MCowBQYDK2VwAyEAjSICb9pp0kHizGQtdG8ySWsDChfGqi+gyFCttigBNOA=
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300

# 32-byte encryption key, base64 encoded, for ER:LC server credentials.
SECRET_ENCRYPTION_KEY_BASE64=

FORWARD_TIMEOUT_MS=5000
FORWARD_MAX_ATTEMPTS=5
FORWARD_RETRY_WINDOW_MS=900000
WORKER_POLL_MS=500
ERLC_API_BASE_URL=https://api.erlc.gg/v2
# Required before outbound ER:LC requests. Set only in a private server environment file; never commit a real key.
ERLC_GLOBAL_API_KEY=
EVENT_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=90
MAINTENANCE_INTERVAL_MS=3600000

# Emergency switch for hosted ER:LC commands. Incoming events, Poll, and forwarding continue when disabled.
HOSTED_COMMANDS_ENABLED=true
